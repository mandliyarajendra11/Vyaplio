# Optional – leave both empty to run fully local (IndexedDB only, nothing leaves the phone).
# To enable cloud sync: Supabase dashboard → Project Settings → API (Data API)
#   NEXT_PUBLIC_SUPABASE_URL      = Project URL, e.g. https://abcdefghijklmnop.supabase.co
#   NEXT_PUBLIC_SUPABASE_ANON_KEY = the "anon" / publishable key (never the service_role / secret key)
# Run supabase/schema.sql in the SQL Editor first, then copy this file to .env.local and rebuild (npm run build).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required for server-side paid-shop provisioning. Keep this secret on the server only.
# Run supabase/admin.sql after supabase/schema.sql and grant your own Auth user admin access.
# Never prefix this key with NEXT_PUBLIC_ or put it in a browser/client environment.
SUPABASE_SERVICE_ROLE_KEY=

# Optional purchase-enquiry WhatsApp number, country code + digits only (example: 919876543210).
# Without this, the pricing page lets buyers copy an enquiry; it does not claim to process payments.
NEXT_PUBLIC_SALES_WHATSAPP=
